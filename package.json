{
  "name": "driverush-ke",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cars": "node scripts/build-real-cars.mjs && node scripts/build-car-wrap.mjs",
    "build:car-wrap": "node scripts/build-car-wrap.mjs",
    "build:car-thumbs": "node scripts/build-car-thumbs.mjs",
    "build:sponsors": "node scripts/build-sponsor-art.mjs",
    "render:sponsor": "node scripts/render-sponsor-car.mjs",
    "build": "react-router build && node scripts/upload-sourcemaps.mjs",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run --project unit",
    "ping-indexnow": "node scripts/ping-indexnow.mjs",
    "build:og": "node scripts/build-og-images.mjs",
    "build:sign-images": "node scripts/build-sign-images.mjs",
    "build:board-pdf": "node scripts/build-board-pdf.mjs",
    "build:pwa": "node scripts/build-pwa-assets.mjs",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:diff:check": "supabase db diff 2>&1 | grep -q \"No schema changes found\"",
    "db:migration:new": "supabase migration new",
    "db:gen-types": "supabase gen types typescript --local > app/lib/supabase/database.types.ts && prettier --write app/lib/supabase/database.types.ts",
    "db:types:check": "npm run db:gen-types && git diff --exit-code app/lib/supabase/database.types.ts",
    "test:pgtap": "supabase test db",
    "test:db": "npm run test:pgtap && vitest run --project db"
  },
  "dependencies": {
    "@posthog/react": "^1.10.3",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "isbot": "^5.1.36",
    "matter-js": "^0.20.0",
    "nipplejs": "^1.0.4",
    "posthog-js": "^1.410.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-confetti-boom": "^2.0.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-router": "7.14.0",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@mdx-js/rollup": "^3.1.1",
    "@posthog/cli": "^0.20.1",
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/matter-js": "^0.20.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.3.0",
    "opentype.js": "^2.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "sharp": "^0.35.5",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0"
  }
}
