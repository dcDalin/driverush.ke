# PostHog: one project, "DriveRush", for every environment. Each event is
# stamped app_env = production (Vercel Production build) or development
# (localhost), and the project's test filter hides development by default.
# Set both values here and in Vercel Production. Vercel Preview gets neither,
# so preview deploys send nothing. Production sends events through
# driverush.ke/ingest (vercel.json); local dev talks to the host below.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog source maps, so error tracking shows real file and line numbers.
# Build-time only: set these in Vercel (Production), not here. They are listed
# so the names are on record. The build uploads maps only when the key is set
# (scripts/upload-sourcemaps.mjs). Never prefix them with VITE_, or the key
# would ship to browsers.
#   POSTHOG_CLI_API_KEY     personal API key, scope "error tracking: write"
#   POSTHOG_CLI_PROJECT_ID  the number in the PostHog project's URL
# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=

# Google Analytics 4 property for this environment. Production (Vercel
# Production) uses the DriveRush property; local, Vercel Preview and
# Development use the separate DriveRush (dev) property. Leave empty to turn
# GA off.
VITE_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (accounts, schools, saved progress). Local values: run
# `npm run db:start`, then `npx supabase status -o env` and copy API_URL,
# PUBLISHABLE_KEY and SERVICE_ROLE_KEY here. Production values come from the
# hosted project (Settings > API) and go in Vercel. The service role key
# bypasses row level security: server only, never prefixed with VITE_.
SUPABASE_URL=http://127.0.0.1:54721
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=http://127.0.0.1:54721
VITE_SUPABASE_PUBLISHABLE_KEY=

# Shows "Continue with Google" in the sign-in sheet. Turn on only where the
# Google provider has keys (hosted project, or the local ones below).
VITE_AUTH_GOOGLE=

# Google sign-in for the local stack (read by supabase/config.toml from
# supabase/.env, not this file). Optional; without them Google stays off.
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
